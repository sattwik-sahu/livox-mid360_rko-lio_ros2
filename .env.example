# Copy to .env and edit
# Choice of ROS2 distro: jazzy | kilted | lyrical
ROS_DISTRO=jazzy
# ROS domain isolation (0-232)
ROS_DOMAIN_ID=0

# Network — MUST match your host NIC static IP and LiDAR IP
HOST_IP=192.168.1.5
LIDAR_IP=192.168.1.12

# Zenoh RMW (do not change unless you know)
RMW_IMPLEMENTATION=rmw_zenoh_cpp

# GHCR (for docker compose pull) — no token needed for public images; for private set:
# GITHUB_TOKEN=ghp_xxx   # used by docker login in CI; do NOT commit .env
