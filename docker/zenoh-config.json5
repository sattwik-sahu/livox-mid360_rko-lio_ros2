{
  // Zenoh router config for ros2 rmw_zenoh_cpp
  // Reference: https://github.com/ros2/rmw_zenoh
  mode: "router",
  listen: {
    endpoints: [
      "tcp/0.0.0.0:7447",
    ],
  },
  scouting: {
    multicast: {
      enabled: true,
      address: "224.0.0.224:7446",
    },
    gossip: {
      enabled: true,
      autoconnect: { peers: "router" },
    },
  },
}
